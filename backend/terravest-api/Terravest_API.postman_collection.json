                        },
                        "url": {
                            "raw": "{{base_url}}/api/sell",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "sell"
                            ]
                        },
                        "description": "Sell tokens for a property. property_id and token_amount must be positive numbers. A 1.5% trading fee is deducted from the sale amount."
                    },
                    "response": []
