                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"propertyId\": 1,\n    \"tokenAmount\": 10\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/buy",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "buy"
                            ]
                        },
                        "description": "Purchase tokens for a property. propertyId and tokenAmount must be positive integers."
                    },
                    "response": []
                }
            ],
            "description": "Buy tokens for properties"
        },
