{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "terravest-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-03",
	"compatibility_flags": ["nodejs_compat"],

	

	"observability": {
		"enabled": true
	},

	// ==========================================
	// 🌍 PRODUCTION ENV VARIABLES
	// ==========================================

	"vars": {
		"ENVIRONMENT": "production",
		"FRONTEND_URL": "https://terravest-frontend.pages.dev",
		"VITE_API_URL": "https://terravest-api.terravest.workers.dev/api" 
	},

	// ==========================================
	// 🗄️ D1 DATABASE
	// ==========================================
	"d1_databases": [
		{
			"binding": "terravest_db",
			"database_name": "terravest-db",
			"database_id": "c18f2c05-572c-465f-9b91-7d11d3928e70",
			"migrations_dir": "db/migrations"
		}
	],

	// ==========================================
	// ⏱️ CRON JOBS
	// ==========================================
	// */10 * * * * -> Payment check every 10 minutes
	// 0 1 * * * -> Rent distribution daily at 01:00 UTC
	"triggers": {
		"crons": [
			"*/10 * * * *",
			"0 1 * * *"
		]
	},

	// ==========================================
	// 🪣 R2 BUCKET
	// ==========================================
	"r2_buckets": [
		{
			"binding": "TERRAVEST_BUCKET",
			"bucket_name": "terravest-images",
			"preview_bucket_name": "terravest-images"
		}
	]
}
